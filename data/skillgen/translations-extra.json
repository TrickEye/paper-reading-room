{
  "alg1.l1": "1: 归纳子集 \\mathcal{D}_{\\mathrm{ind}}, 构建期验证子集 \\mathcal{D}_{\\mathrm{ver}}, 基础智能体 \\mathcal{A}, 评估器 \\mathcal{E}, 轮数预算 K\\geq 1, 门控参数 g_{\\mathrm{abs}}\\in\\mathbb{Z}_{\\geq 0} 与 g_{\\mathrm{rel}}\\in[0,1]",
  "alg1.l2": "2: 技能 s^{\\star}标记为 \\mathrm{active} 或 \\mathrm{deprecated}",
  "alg1.l3": "3: 阶段 1：基线采集",
  "alg1.l4": "4: 收集归纳轨迹 \\mathcal{B}=\\{(x_{i},\\tau_{i}^{0},y_{i}^{0})\\}_{i=1}^{n}，通过运行 \\mathcal{A} 于 \\mathcal{D}_{\\mathrm{ind}}",
  "alg1.l5": "5: 缓存验证基线 \\mathcal{B}_{\\mathrm{ver}}=\\{(\\tilde{x}_{j},\\tilde{\\tau}^{0}_{j},b_{j})\\}_{j=1}^{m}，通过运行 \\mathcal{A} 于 \\mathcal{D}_{\\mathrm{ver}}",
  "alg1.l6": "6: 阶段 2：对比行为归纳",
  "alg1.l7": "7: 归纳智能体将轨迹分析为 \\mathcal{Z}=(a_{0},\\mathcal{F},\\mathcal{S},\\mathcal{C})",
  "alg1.l8": "8: 阶段 3：生成—验证—改进",
  "alg1.l9": "9: 初始化 \\Phi^{(0)}\\leftarrow\\varnothing, g^{\\star}\\leftarrow-\\infty, s^{\\star}\\leftarrow\\varnothing",
  "alg1.l10": "10: 设置门控阈值 \\gamma_{m}\\leftarrow\\max\\{g_{\\mathrm{abs}},\\lceil g_{\\mathrm{rel}}m\\rceil,1\\}",
  "alg1.l11": "11: 对于 r=1,\\ldots,K 执行",
  "alg1.l12": "12: 生成智能体计算 s^{(r)}\\leftarrow\\begin{cases}\\operatorname{Gen}(\\mathcal{Z}),&\\text{for }r=1,\\\\ \\operatorname{Refine}(s^{(r-1)},\\mathcal{Z},\\Phi^{(r-1)}),&\\text{for }r>1\\end{cases}",
  "alg1.l13": "13: 验证智能体评估 s^{(r)}，遍历全部 \\tilde{x}_{j}\\in\\mathcal{D}_{\\mathrm{ver}}，并计算 G_{m}(s^{(r)})",
  "alg1.l14": "14: 验证智能体构建反馈 \\Phi^{(r)}，依据修复、退化和未解决失败",
  "alg1.l15": "15: 若 G_{m}(s^{(r)})>g^{\\star}，则",
  "alg1.l16": "16: g^{\\star}\\leftarrow G_{m}(s^{(r)}), s^{\\star}\\leftarrow s^{(r)}",
  "alg1.l17": "17: 结束条件",
  "alg1.l18": "18: 结束循环",
  "alg1.l19": "19: 若 g^{\\star}\\geq\\gamma_{m}，将 s^{\\star} 标记为 \\mathrm{active}；否则标记为 \\mathrm{deprecated}",
  "alg1.l20": "20: 返回 s^{\\star}",
