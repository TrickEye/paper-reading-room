  {
    "id": "S3.E2",
    "mathml": "<table id=\"S3.E2\" class=\"ltx_equation ltx_eqn_table\">\n\n<tbody><tr class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_eqn_cell ltx_align_center\"><math id=\"S3.E2.m1\" class=\"ltx_Math\" alttext=\"\\mathcal{B}=\\{(x_{i},\\tau^{0}_{i},y^{0}_{i})\\}_{i=1}^{n},\\qquad\\mathcal{I}^{-}=\\{i:y^{0}_{i}=0\\},\\quad\\mathcal{I}^{+}=\\{i:y^{0}_{i}=1\\}.\" display=\"block\" intent=\":literal\"><semantics><mrow><mrow><mrow><mi class=\"ltx_font_mathcaligraphic\">ℬ</mi><mo>=</mo><msubsup><mrow><mo stretchy=\"false\">{</mo><mrow><mo stretchy=\"false\">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>τ</mi><mi>i</mi><mn>0</mn></msubsup><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mn>0</mn></msubsup><mo stretchy=\"false\">)</mo></mrow><mo stretchy=\"false\">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup></mrow><mo rspace=\"2.167em\">,</mo><mrow><msup><mi class=\"ltx_font_mathcaligraphic\">ℐ</mi><mo>−</mo></msup><mo>=</mo><mrow><mo stretchy=\"false\">{</mo><mi>i</mi><mo lspace=\"0.278em\" rspace=\"0.278em\">:</mo><mrow><msubsup><mi>y</mi><mi>i</mi><mn>0</mn></msubsup><mo>=</mo><mn>0</mn></mrow><mo stretchy=\"false\">}</mo></mrow></mrow><mo rspace=\"1.167em\">,</mo><mrow><msup><mi class=\"ltx_font_mathcaligraphic\">ℐ</mi><mo>+</mo></msup><mo>=</mo><mrow><mo stretchy=\"false\">{</mo><mi>i</mi><mo lspace=\"0.278em\" rspace=\"0.278em\">:</mo><mrow><msubsup><mi>y</mi><mi>i</mi><mn>0</mn></msubsup><mo>=</mo><mn>1</mn></mrow><mo stretchy=\"false\">}</mo></mrow></mrow></mrow><mo lspace=\"0em\">.</mo></mrow><annotation encoding=\"application/x-tex\">\\mathcal{B}=\\{(x_{i},\\tau^{0}_{i},y^{0}_{i})\\}_{i=1}^{n},\\qquad\\mathcal{I}^{-}=\\{i:y^{0}_{i}=0\\},\\quad\\mathcal{I}^{+}=\\{i:y^{0}_{i}=1\\}.</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td>\n<td rowspan=\"1\" class=\"ltx_eqn_cell ltx_eqn_eqno ltx_align_middle lt