    "id": "S3.E5",
    "mathml": "<table id=\"S3.E5\" class=\"ltx_equation ltx_eqn_table\">\n\n<tbody><tr class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_eqn_cell ltx_align_center\"><math id=\"S3.E5.m1\" class=\"ltx_Math\" alttext=\"\\Pi^{-}=\\operatorname{Cluster}\\big(\\{e_{i}^{-}:i\\in\\mathcal{I}^{-}\\}\\big),\\qquad f_{P}=\\operatorname{Summ}^{-}\\big(\\{(x_{i},\\tau_{i}^{0},\\rho_{i}^{-}):i\\in P\\}\\big)\" display=\"block\" intent=\":literal\"><semantics><mrow><mrow><msup><mi mathvariant=\"normal\">Π</mi><mo>−</mo></msup><mo>=</mo><mrow><mi>Cluster</mi><mo>⁡</mo><mrow><mo maxsize=\"1.200em\" minsize=\"1.200em\">(</mo><mrow><mo stretchy=\"false\">{</mo><msubsup><mi>e</mi><mi>i</mi><mo>−</mo></msubsup><mo lspace=\"0.278em\" rspace=\"0.278em\">:</mo><mrow><mi>i</mi><mo>∈</mo><msup><mi class=\"ltx_font_mathcaligraphic\">ℐ</mi><mo>−</mo></msup></mrow><mo stretchy=\"false\">}</mo></mrow><mo maxsize=\"1.200em\" minsize=\"1.200em\">)</mo></mrow></mrow></mrow><mo rspace=\"2.167em\">,</mo><mrow><msub><mi>f</mi><mi>P</mi></msub><mo>=</mo><mrow><msup><mi>Summ</mi><mo>−</mo></msup><mo>⁡</mo><mrow><mo maxsize=\"1.200em\" minsize=\"1.200em\">(</mo><mrow><mo stretchy=\"false\">{</mo><mrow><mo stretchy=\"false\">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>τ</mi><mi>i</mi><mn>0</mn></msubsup><mo>,</mo><msubsup><mi>ρ</mi><mi>i</mi><mo>−</mo></msubsup><mo rspace=\"0.278em\" stretchy=\"false\">)</mo></mrow><mo rspace=\"0.278em\">:</mo><mrow><mi>i</mi><mo>∈</mo><mi>P</mi></mrow><mo stretchy=\"false\">}</mo></mrow><mo maxsize=\"1.200em\" minsize=\"1.200em\">)</mo></mrow></mrow></mrow></mrow><annotation encoding=\"application/x-tex\">\\Pi^{-}=\\operatorname{Cluster}\\big(\\{e_{i}^{-}:i\\in\\mathcal{I}^{-}\\}\\big),\\qquad f_{P}=\\operatorname{Summ}^{-}\\big(\\{(x_{i},\\tau_{i}^{0},\\rho_{i}^{-}):i\\in P\\}\\big)</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td