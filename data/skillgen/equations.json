    "id": "S2.E1",
    "mathml": "<table id=\"S2.E1\" class=\"ltx_equation ltx_eqn_table\">\n\n<tbody><tr class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_eqn_cell ltx_align_center\"><math id=\"S2.E1.m1\" class=\"ltx_math_unparsed\" alttext=\"\\Delta(s)\\;=\\;\\mathbb{E}_{x\\sim p}\\left[\\mathbb{E}\\!\\left[Y^{s}(x)\\mid x,s\\right]-\\mathbb{E}\\!\\left[Y^{0}(x)\\mid x\\right]\\right].\" display=\"block\" intent=\":literal\"><semantics><mrow><mi mathvariant=\"normal\">Δ</mi><mrow><mo stretchy=\"false\">(</mo><mi>s</mi><mo rspace=\"0.280em\" stretchy=\"false\">)</mo></mrow><mo rspace=\"0.558em\">=</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi>p</mi></mrow></msub><mrow><mo>[</mo><mpadded style=\"width:0.497em;\" width=\"0.497em\"><mi>𝔼</mi></mpadded><mrow><mo>[</mo><msup><mi>Y</mi><mi>s</mi></msup><mrow><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mrow><mo lspace=\"0em\" rspace=\"0.167em\">∣</mo><mi>x</mi><mo>,</mo><mi>s</mi><mo>]</mo></mrow><mo>−</mo><mpadded style=\"width:0.497em;\" width=\"0.497em\"><mi>𝔼</mi></mpadded><mrow><mo>[</mo><msup><mi>Y</mi><mn>0</mn></msup><mrow><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mrow><mo lspace=\"0em\" rspace=\"0.167em\">∣</mo><mi>x</mi><mo>]</mo></mrow><mo>]</mo></mrow><mo lspace=\"0em\">.</mo></mrow><annotation encoding=\"application/x-tex\">\\Delta(s)\\;=\\;\\mathbb{E}_{x\\sim p}\\left[\\mathbb{E}\\!\\left[Y^{s}(x)\\mid x,s\\right]-\\mathbb{E}\\!\\left[Y^{0}(x)\\mid x\\right]\\right].</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td>\n<td rowspan=\"1\" class=\"ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right\"><span class=\"ltx_tag ltx_tag_equation ltx_align_right\">(1)</span></td></tr></tbody>\n</table>"
