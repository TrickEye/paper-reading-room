    "id": "S3.E4",
    "mathml": "<table id=\"S3.E4\" class=\"ltx_equation ltx_eqn_table\">\n\n<tbody><tr class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_eqn_cell ltx_align_center\"><math id=\"S3.E4.m1\" class=\"ltx_Math\" alttext=\"\\operatorname{Compress}(\\mathcal{B})=\\mathcal{Z}=(a_{0},\\mathcal{F},\\mathcal{S},\\mathcal{C}),\" display=\"block\" intent=\":literal\"><semantics><mrow><mrow><mrow><mi>Compress</mi><mo>⁡</mo><mrow><mo stretchy=\"false\">(</mo><mi class=\"ltx_font_mathcaligraphic\">ℬ</mi><mo stretchy=\"false\">)</mo></mrow></mrow><mo>=</mo><mi class=\"ltx_font_mathcaligraphic\">𝒵</mi><mo>=</mo><mrow><mo stretchy=\"false\">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi class=\"ltx_font_mathcaligraphic\">ℱ</mi><mo>,</mo><mi class=\"ltx_font_mathcaligraphic\">𝒮</mi><mo>,</mo><mi class=\"ltx_font_mathcaligraphic\">𝒞</mi><mo stretchy=\"false\">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding=\"application/x-tex\">\\operatorname{Compress}(\\mathcal{B})=\\mathcal{Z}=(a_{0},\\mathcal{F},\\mathcal{S},\\mathcal{C}),</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td>\n<td rowspan=\"1\" class=\"ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right\"><span class=\"ltx_tag ltx_tag_equation ltx_align_right\">(4)</span></td></tr></tbody>\n</table>"
