[
  {
    "id": "alg1.l1",
    "kind": "algorithm-line",
    "en": "1: induction subset \\mathcal{D}_{\\mathrm{ind}}, construction-time verification subset \\mathcal{D}_{\\mathrm{ver}}, base agent \\mathcal{A}, evaluator \\mathcal{E}, round budget K\\geq 1, gate parameters g_{\\mathrm{abs}}\\in\\mathbb{Z}_{\\geq 0} and g_{\\mathrm{rel}}\\in[0,1]"
  },
  {
    "id": "alg1.l2",
    "kind": "algorithm-line",
    "en": "2: skill s^{\\star} marked \\mathrm{active} or \\mathrm{deprecated}"
  },
  {
    "id": "alg1.l3",
    "kind": "algorithm-line",
    "en": "3: Stage 1 Baseline elicitation"
  },
  {
    "id": "alg1.l4",
    "kind": "algorithm-line",
    "en": "4: Collect induction trajectories \\mathcal{B}=\\{(x_{i},\\tau_{i}^{0},y_{i}^{0})\\}_{i=1}^{n} by rolling out \\mathcal{A} on \\mathcal{D}_{\\mathrm{ind}}"
  },
  {
    "id": "alg1.l5",
    "kind": "algorithm-line",
    "en": "5: Cache verification baselines \\mathcal{B}_{\\mathrm{ver}}=\\{(\\tilde{x}_{j},\\tilde{\\tau}^{0}_{j},b_{j})\\}_{j=1}^{m} by rolling out \\mathcal{A} on \\mathcal{D}_{\\mathrm{ver}}"
  },
  {
    "id": "alg1.l6",
    "kind": "algorithm-line",
    "en": "6: Stage 2 Contrastive behavioral induction"
  },
  {
    "id": "alg1.l7",
    "kind": "algorithm-line",
    "en": "7: Induction agent analyzes trajectories into \\mathcal{Z}=(a_{0},\\mathcal{F},\\mathcal{S},\\mathcal{C})"
  },
  {
    "id": "alg1.l8",
    "kind": "algorithm-line",
    "en": "8: Stage 3 Generation–verification–refinement"
  },
  {
    "id": "alg1.l9",
    "kind": "algorithm-line",
    "en": "9: Initialize \\Phi^{(0)}\\leftarrow\\varnothing, g^{\\star}\\leftarrow-\\infty, s^{\\star}\\leftarrow\\varnothing"
  },
  {
    "id": "alg1.l10",
    "kind": "algorithm-line",
    "en": "10: Set gate threshold \\gamma_{m}\\leftarrow\\max\\{g_{\\mathrm{abs}},\\lceil g_{\\mathrm{rel}}m\\rceil,1\\}"
  },
  {
    "id": "alg1.l11",
    "kind": "algorithm-line",
    "en": "11: for r=1,\\ldots,K do"
  },
  {
    "id": "alg1.l12",
    "kind": "algorithm-line",
    "en": "12: Generation agent computes s^{(r)}\\leftarrow\\begin{cases}\\operatorname{Gen}(\\mathcal{Z}),&\\text{for }r=1,\\\\ \\operatorname{Refine}(s^{(r-1)},\\mathcal{Z},\\Phi^{(r-1)}),&\\text{for }r>1\\end{cases}"
  },
  {
    "id": "alg1.l13",
    "kind": "algorithm-line",
    "en": "13: Verification agent evaluates s^{(r)} on all \\tilde{x}_{j}\\in\\mathcal{D}_{\\mathrm{ver}} and computes G_{m}(s^{(r)})"
  },
  {
    "id": "alg1.l14",
    "kind": "algorithm-line",
    "en": "14: Verification agent builds feedback \\Phi^{(r)} from repairs, regressions, and unresolved failures"
  },
  {
    "id": "alg1.l15",
    "kind": "algorithm-line",
    "en": "15: if G_{m}(s^{(r)})>g^{\\star} then"
  },
  {
    "id": "alg1.l16",
    "kind": "algorithm-line",
    "en": "16: g^{\\star}\\leftarrow G_{m}(s^{(r)}), s^{\\star}\\leftarrow s^{(r)}"
  },
  {
    "id": "alg1.l17",
    "kind": "algorithm-line",
    "en": "17: end if"
  },
  {
    "id": "alg1.l18",
    "kind": "algorithm-line",
    "en": "18: end for"
  },
  {
    "id": "alg1.l19",
    "kind": "algorithm-line",
    "en": "19: Mark s^{\\star} as \\mathrm{active} if g^{\\star}\\geq\\gamma_{m}, else mark it as \\mathrm{deprecated}"
  },
  {
    "id": "alg1.l20",
    "kind": "algorithm-line",
    "en": "20: return s^{\\star}"
  },
